{
  "expo": {
    "name": "גינה חיה",
    "slug": "gina-haya",
    "owner": "harelzilberman",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a0e"
    },
    "android": {
      "package": "com.ginahaya.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1a0e"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "ginahaya"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#c4860a"
    },
    "plugins": [
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "מאפשר לאפליקציה לקבוע המלצות לפי אזורך"
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "גינה חיה צריכה גישה למיקרופון כדי שתוכל לדבר עם צ'ופצ'ו"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "גינה חיה צריכה גישה לגלריה כדי להוסיף תמונות ליומן",
          "cameraPermission": "גינה חיה צריכה גישה למצלמה כדי לצלם תמונות ליומן"
        }
      ],
    ],
    "scheme": "ginahaya"
  }
}
