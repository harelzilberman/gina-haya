# API environment variables (NEVER expose these to the browser)
PORT=3001
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
RESEND_API_KEY=your_resend_api_key_here
JWT_SECRET=generate_a_long_random_string_here
NODE_ENV=development
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_GROWER=price_...
STRIPE_PRICE_GARDENER_PRO=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
ADMIN_EMAIL=your-email@gmail.com
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Grow payments (formerly Meshulam) — Israeli payment gateway
GROW_USER_ID=
# Make.com webhook that creates the Grow one-time payment link.
# A Router inside the Make scenario branches on the `paymentMode` field in the request body:
#   one_time_monthly → Grow module capped at 1 installment (monthly trial)
#   one_time_annual  → Grow module allowing up to 12 installments (annual)
# No code-level distinction needed — Make handles the branching internally.
GROW_MAKE_WEBHOOK_URL=
# Make.com webhook that creates the Grow recurring/subscription payment link
GROW_MAKE_WEBHOOK_URL_RECURRING=
# Page code for the Grow recurring/subscription scenario (used inside Make)
GROW_PAGE_CODE_RECURRING=
# API host used by the webhook handler for approveTransaction calls
# sandbox.meshulam.co.il (testing) | api.meshulam.co.il (production)
GROW_API_HOST=sandbox.meshulam.co.il
# Secret token embedded in the webhook URL — Grow's PaymentLinks format has no per-call signing.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Configure the full URL (https://your-api/api/billing/grow/webhook/TOKEN) in the Grow dashboard.
GROW_WEBHOOK_SECRET=
