# API environment variables (NEVER expose these to the browser)
PORT=3001
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-4-5
# Override the text-only chat model without touching vision or full-diagnosis paths
CHAT_TEXT_MODEL=
# Sampling temperature for Chupchu text chat (default 0.4, valid range 0–1)
CHAT_TEMPERATURE=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
RESEND_API_KEY=your_resend_api_key_here
JWT_SECRET=generate_a_long_random_string_here
NODE_ENV=development
ADMIN_EMAIL=your-email@gmail.com
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# ── Lemon Squeezy payments ────────────────────────────────────────────────────
# API key from your Lemon Squeezy account (Settings → API)
LEMONSQUEEZY_API_KEY=
# Store ID (shown in the Lemon Squeezy dashboard URL)
LEMONSQUEEZY_STORE_ID=
# Webhook signing secret (Lemon Squeezy → Settings → Webhooks → your webhook → Signing secret)
LEMONSQUEEZY_WEBHOOK_SECRET=

# Subscription variant IDs (Lemon Squeezy → Products → your product → Variants)
LEMONSQUEEZY_VARIANT_GARDENER_PRO_MONTHLY=
LEMONSQUEEZY_VARIANT_GARDENER_PRO_YEARLY=
LEMONSQUEEZY_VARIANT_ADVANCED_MONTHLY=
LEMONSQUEEZY_VARIANT_ADVANCED_YEARLY=
LEMONSQUEEZY_VARIANT_PROFESSIONAL_MONTHLY=
LEMONSQUEEZY_VARIANT_PROFESSIONAL_YEARLY=

# Credit pack variant IDs
LEMONSQUEEZY_VARIANT_ANALYSIS_SINGLE=
LEMONSQUEEZY_VARIANT_ANALYSIS_PACK_5=
LEMONSQUEEZY_VARIANT_ANALYSIS_PACK_10=
LEMONSQUEEZY_VARIANT_TRACKER_SINGLE=
LEMONSQUEEZY_VARIANT_TRACKER_PACK_5=
LEMONSQUEEZY_VARIANT_TRACKER_PACK_10=
